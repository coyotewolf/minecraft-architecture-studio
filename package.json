{
  "name": "minecraft-architecture-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:lint-toolchain": "node scripts/verify-lint-toolchain.mjs",
    "build:server": "vite build --ssr server/start.ts --outDir dist-server",
    "start": "node dist-server/start.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "file:vendor/three"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
